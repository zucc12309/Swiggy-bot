# App
DEBUG=false
MESSAGING_PLATFORM=telegram
# Public base URL of this bot — used as the Swiggy OAuth redirect_uri.
# Must be HTTPS in production. Allowlist with builders@swiggy.in.
PUBLIC_BASE_URL=https://your-domain.com

# Database — replace changeme with a strong password
DATABASE_URL=postgresql+asyncpg://swiggy_bot:changeme@localhost:5432/swiggy_bot

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Telegram (Phase 1)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook/telegram

# WhatsApp (Phase 2)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# Swiggy Builders Club MCP
# No static token — auth is per-user OAuth 2.1 + PKCE. URLs below are
# the JSON-RPC endpoints; client registers itself via DCR on first use.
SWIGGY_FOOD_MCP_URL=https://mcp.swiggy.com/food
SWIGGY_INSTAMART_MCP_URL=https://mcp.swiggy.com/im
SWIGGY_DINEOUT_MCP_URL=https://mcp.swiggy.com/dineout
